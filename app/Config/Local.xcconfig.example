//
// Local.xcconfig.example — copy this file to Local.xcconfig (same
// directory) to wire your own signing team in for on-device runs.
// Local.xcconfig is git-ignored: your team id never reaches this repo's
// history, and the committed project (Firefly.xcconfig) stays unsigned
// for everyone else's clean checkout.
//
// Usage:
//   cp app/Config/Local.xcconfig.example app/Config/Local.xcconfig
//   # edit the line below with your own team id, then in Xcode:
//   #   Signing & Capabilities -> Team, and set CODE_SIGNING_ALLOWED=YES
//   #   (or just let Xcode's "Automatically manage signing" do it once
//   #   DEVELOPMENT_TEAM is set here).
//
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// TestFlight archives (app/tools/testflight.sh) need nothing more from
// this file than DEVELOPMENT_TEAM above. Do NOT add a per-config
// CODE_SIGN_IDENTITY override here to force "Apple Distribution" for
// Release — that was tried and Xcode rejects it outright ("conflicting
// provisioning settings") against CODE_SIGN_STYLE = Automatic. The
// archive step signs with whatever identity is already available
// (typically Apple Development); the EXPORT step
// (app/tools/testflight.sh, ExportOptions.plist's `signingStyle:
// automatic` + `method: app-store-connect`) is what actually asks
// Apple for a Distribution certificate and an App Store provisioning
// profile and re-signs with those — standard Xcode behavior, not
// something this file needs to arrange.
