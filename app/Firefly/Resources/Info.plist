<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- Export compliance (App Store Connect asks this on every
	     TestFlight/App Store submission otherwise). Firefly's only
	     network use is the phone <-> node BLE link and whatever HTTPS
	     the OS itself makes on the app's behalf — both standard,
	     exempt encryption — so this answers the question once, here,
	     rather than by hand in App Store Connect's UI each build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Bluetooth. The app is a Meshtastic CLIENT: it connects to a node
	     the user owns and does not advertise anything.
	     Owner decision, 2026-09-13 ("Permission strings"): "your puck",
	     never "Meshtastic node" — a permission dialog is the worst place
	     to introduce a brand name someone installing this for a
	     festival has never heard of. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Firefly connects to your puck over Bluetooth so you can see your crew and send messages.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Firefly connects to your puck over Bluetooth so you can see your crew and send messages.</string>

	<!-- Location. The phone's own GPS is pushed to the node as an
	     external fix, because the Heltec V3 bench boards have no GNSS at
	     all (docs/hardware/heltec-v3.md). "Always" is requested only
	     because a festival's whole point is that the phone is in a
	     pocket while the mesh keeps working. A02 §6.2 reword. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Firefly shares your location with your puck so your crew can find you, even with no signal.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Firefly shares your location with your puck so your crew can find you, even with no signal. Keeping this on in the background means your crew can still find you while your phone is in your pocket.</string>

	<!-- Camera. iOS only — the Connect screen's channel-QR scan sheet
	     and, since A02, the Join-a-crew scanner (QRScannerSheet.swift,
	     CrewJoinView.swift). macOS never asks: the paste/typed-code
	     fields are the whole story there. A02 §3.1/§6.2 reword — the
	     key already shipped, saying "channel"; this is a reword, not a
	     new key. -->
	<key>NSCameraUsageDescription</key>
	<string>Firefly uses the camera to scan your friend's crew code.</string>

	<!-- A02 §1.8 — the app registers no URL scheme before this. A crew's
	     QR/Share-link payload is `firefly://crew?v=1&code=…&name=…`,
	     routed by `FireflyApp`'s `onOpenURL` to the Join flow. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>firefly</string>
			</array>
		</dict>
	</array>

	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
