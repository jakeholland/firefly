.DS_Store
.claude/
build/
*.bin
# S03: hand-crafted meshclient test fixtures are committed .bin files, not
# build output — see docs/specs/S03-meshclient.md and
# firmware/meshclient/tools/dev/record_fixture.py.
!firmware/meshclient/tests/fixtures/*.bin
# S04: the golden bytes fixture is committed too — see
# docs/specs/S04-firefly-protocol.md AC5.
!firmware/core/tests/fixtures/*.bin
# S14 hardening pass: fuzz-crash regression corpus (see
# firmware/tests/fuzz/README.md) — committed .bin fixtures, not build
# output, same as the two exceptions above.
!firmware/tests/fuzz/regressions/*.bin
firmware/out/
# S13b: tests/run_goldens.sh's scratch diff-artifact output (regenerated
# on every failing run; only the committed tests/golden/*.png goldens
# themselves are checked in).
firmware/tests/golden/_diff_out/
# S14d: Python scratch dirs from running firmware/tests/e2e/ locally.
__pycache__/
.pytest_cache/

# Python venv for the dev tools (firmware/tests/e2e/requirements.txt)
.venv/
build-gcc/
# S14 hardening pass: additional local sim build trees (ASan/UBSan-only,
# and the FF_BUILD_FUZZERS=ON coverage-guided fuzz tree) — see
# firmware/tests/fuzz/README.md.
build-asan/
build-fuzz/
firmware/build
firmware/build

# Local design working files (Claude Design canvases live as artifacts, not in-repo)
firefly-design/

# pass 13: firefly_case.py's own root-fillet decision log (debugging aid,
# recreated by every build() run — see hardware/case/README.md's pass-13
# section).
hardware/case/_root_fillet_log.jsonl

# --- app/ (A01 companion app) ---
# Xcode build output and per-user state. DerivedData is normally under
# ~/Library, but Xcode can be pointed at a project-relative one.
DerivedData/
*.xcuserdatad/
xcuserdata/
*.xcuserstate
# SwiftPM build tree and per-user scratch. app/FireflyKit/Package.resolved
# IS committed: FireflyKit is an application package, so an exact
# dependency pin is what makes a CI build reproducible.
app/FireflyKit/.build/
app/FireflyKit/.swiftpm/
# Personal on-device signing team, never committed. Copy
# app/Config/Local.xcconfig.example to app/Config/Local.xcconfig and put
# your own DEVELOPMENT_TEAM there. app/Config/Firefly.xcconfig (committed)
# includes it optionally, so its absence never breaks a clean checkout.
app/Config/Local.xcconfig
